<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Gabay Store"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RmmcGabay"
        tools:targetApi="31">
        <activity
            android:name=".views.Checkout"
            android:label="Checkout"
            android:exported="false" />
        <activity
            android:name=".views.edit.EditUser"
            android:exported="false"
            android:label="Manage user"
            android:parentActivityName=".views.Manage" />
        <activity
            android:name=".views.edit.EditCategory"
            android:exported="false"
            android:label="Manage category"
            android:parentActivityName=".views.Manage" />
        <activity
            android:name=".views.edit.EditProduct"
            android:exported="false"
            android:label="Manage product"
            android:parentActivityName=".views.Manage" />
        <activity
            android:label="Manage System"
            android:name=".views.Manage"
            android:exported="false" />
        <activity
            android:label="Dashboard"
            android:name=".views.Hero"
            android:exported="false" />
        <activity
            android:label="Gabay Store"
            android:name=".views.Login"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".actions.BarcodeCapture"
            android:screenOrientation="fullSensor"
            android:stateNotNeeded="true"
            android:theme="@style/zxing_CaptureTheme" />
    </application>

</manifest>